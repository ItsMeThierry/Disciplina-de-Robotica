<?xml version="1.0"?>
<robot name="vasco_robot">

  <!-- Link base oculto -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Chassi principal (Preto) -->
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="-0.065 0 -0.03"/>
      <inertia ixx="0.00417" ixy="0.0" ixz="0.0" iyy="0.01417" iyz="0.0" izz="0.01667"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </visual>
    <visual name="vasco_visual">
      <origin xyz="0 -0.55 -0.35" rpy="1.5 0 1.5"/>
      <geometry>
        <mesh filename="$(find pratica_03)/meshes/vasco.stl" scale="0.005 0.005 0.005"/>
      </geometry>
    </visual>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Faixa Diagonal Branca -->
  <link name="white_stripe">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0.46"/>
      <geometry>
        <box size="0.41 0.04 0.102"/>
      </geometry>
    </visual>
  </link>
  <joint name="stripe_joint" type="fixed">
    <parent link="base_link"/>
    <child link="white_stripe"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="white_stripe">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- Cruz Vermelha (Vertical) -->
  <link name="cross_v">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.08 0.01"/>
      </geometry>
    </visual>
  </link>
  <joint name="cross_v_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cross_v"/>
    <origin xyz="0.08 0.05 0.055" rpy="0 0 0"/>
  </joint>
  <gazebo reference="cross_v">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Cruz Vermelha (Horizontal) -->
  <link name="cross_h">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.01"/>
      </geometry>
    </visual>
  </link>
  <joint name="cross_h_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cross_h"/>
    <origin xyz="0.08 0.05 0.055" rpy="0 0 0"/>
  </joint>
  <gazebo reference="cross_h">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Rodas de apoio (Caster Wheels) -->
  <link name="caster_wheel">
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00025" ixy="0.0" ixz="0.0" iyy="0.00025" iyz="0.0" izz="0.00025"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- Roda Esquerda -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001354" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.001354"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <gazebo reference="left_wheel">
    <material>Gazebo/White</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>

  <!-- Roda Direita -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001354" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.001354"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.13 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  <gazebo reference="right_wheel">
    <material>Gazebo/White</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>

  <!-- Configuração do gazebo_ros2_control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find pratica_03)/config/diff_drive.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/robo_vascaino</namespace>
        <remapping>odom:=ground_truth/pose</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>50.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>